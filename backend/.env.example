# Copy to .env and adjust as needed.

# --- Database ---
# Default (zero-config, for evaluation): SQLite file in the backend directory.
DATABASE_URL=sqlite:///./screening.db
# PostgreSQL (recommended target). Start it with the provided docker-compose.yml:
# DATABASE_URL=postgresql+psycopg2://screening:screening@localhost:5432/screening

# --- Auth ---
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
